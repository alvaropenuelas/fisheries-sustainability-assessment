{
  "name": "fisheries-sustainability-assessment",
  "private": false,
  "version": "1.0.0",
  "type": "module",
  "description": "Two-track sustainability assessment of North Atlantic commercial fish stocks using ICES SAG data and FAO FishStat catch-based proxies. 1990–2023.",
  "author": "Álvaro Peñuelas Sánchez <apenuelas1499@gmail.com>",
  "license": "MIT",
  "homepage": "https://alvaropenuelas.github.io/fisheries-sustainability-assessment",
  "keywords": [
    "fisheries",
    "ICES",
    "marine science",
    "stock assessment",
    "sustainability",
    "North Atlantic",
    "data visualization",
    "React"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "fetch-fao": "Rscript scripts/fetch_fao.R",
    "generate-proxy": "npx tsx scripts/generate_proxy_stocks.ts"
  },
  "dependencies": {
    "framer-motion": "^11.0.0",
    "gsap": "^3.12.5",
    "lucide-react": "^1.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "gh-pages": "^6.1.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.1",
    "typescript": "^5.2.2",
    "vite": "^5.3.1"
  }
}
